{
  "name": "reprint",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:api": "npm run dev --prefix ../RePrint-API",
    "start:api": "npm start --prefix ../RePrint-API",
    "dev:all": "concurrently -n api,web -c green,blue \"npm run dev:api\" \"npm run dev\""
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^9.1.0",
    "vite": "^8.2.2"
  }
}
